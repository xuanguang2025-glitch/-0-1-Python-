# =============================================================================
# PYTHON LAB —— 环境变量全清单（照 docs/ARCHITECTURE.md §8.3）
# 用法：cp .env.example .env 然后按需修改。**不要把 .env 提交到版本库**。
# 说明：留空 = 使用该行的降级行为（系统设计第一原则：外部依赖缺失时自动降级）
# =============================================================================

# ---------------------------------------------------------------- 应用基础
APP_ENV=development                 # 运行环境：development|testing|production（生产必改 production）
APP_NAME=PYTHON LAB                 # 站点名称（前端展示与邮件标题）
APP_VERSION=1.0.0                   # 版本号，同时用作镜像 tag
DEBUG=true                          # 调试模式：生产必须 false（关闭详细堆栈回显）
LOG_LEVEL=INFO                      # 日志级别：DEBUG|INFO|WARNING|ERROR
SECRET_KEY=change-me-in-production  # 通用签名密钥（生产用 openssl rand -hex 32 生成）
API_PREFIX=/api                     # 后端路由前缀，前端 rewrites 与之对应
BACKEND_HOST=127.0.0.1              # 后端监听地址（容器内用 0.0.0.0）
BACKEND_PORT=8000                   # 后端监听端口
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # 允许的跨域来源，逗号分隔
REQUEST_TIMEOUT_MS=30000            # 单请求服务端超时（毫秒）
UPLOAD_DIR=./data/uploads           # 上传文件目录（头像/导入包）
MAX_UPLOAD_MB=10                    # 单文件上传上限（MB），头像另有 2MB 限制

# ------------------------------------------------------------------ 数据库
# 本机无 Docker 时默认 SQLite 文件库；生产改为下面注释里的 Postgres 连接串
DATABASE_URL=sqlite:///./data/pythonlab.db
# DATABASE_URL=postgresql+psycopg://pythonlab:pythonlab_pass@localhost:5432/pythonlab
DB_ECHO=false                       # 是否打印 SQL（排查用，生产 false）
DB_POOL_SIZE=10                     # 连接池大小（SQLite 自动忽略）
SQLITE_WAL=true                     # SQLite 开启 WAL，提升并发读性能

# -------------------------------------------------------------- 缓存（Redis）
CACHE_BACKEND=auto                  # auto|redis|memory —— auto 会探测 Redis，失败自动降级进程内 TTLCache
REDIS_URL=redis://localhost:6379/0  # Redis 连接串（容器内用 redis://redis:6379/0）
CACHE_PROBE_TIMEOUT_MS=800          # 启动期 Redis 探测超时；超时即降级 memory
CACHE_DEFAULT_TTL=300               # 默认缓存过期秒数

# -------------------------------------------------------------- 队列（异步任务）
QUEUE_BACKEND=auto                  # auto|rq|inline —— auto 无 Redis 时降级 inline 同步执行
RQ_QUEUE_NAME=pythonlab             # RQ 队列名

# ------------------------------------------------------------ 认证与安全
JWT_ALGORITHM=HS256                 # JWT 签名算法
JWT_SECRET_KEY=change-me-please     # JWT 专用密钥（生产必须替换，勿与 SECRET_KEY 复用）
ACCESS_TOKEN_TTL_MIN=15             # access token 有效期（分钟），存内存
REFRESH_TOKEN_TTL_DAYS=30           # refresh token 有效期（天），存 localStorage 并轮换
PWD_HASH_SCHEME=bcrypt              # 密码哈希：bcrypt|argon2（bcrypt 兼容性更好）
PWD_MIN_LENGTH=8                    # 密码最小长度（低于则返回 WEAK_PASSWORD）
REGISTER_ENABLED=true               # 是否开放注册（关闭后仅管理员可建号）
DEFAULT_USER_ROLE=user              # 新用户默认角色：user|admin

# ------------------------------------------------------------ 代码执行沙箱
SANDBOX_MODE=auto                   # auto|remote|local|stub —— auto 先探远程，失败降级 backend 内置 LocalRunner
SANDBOX_URL=http://localhost:8081   # 远程沙箱地址（容器内用 http://sandbox:8081）
SANDBOX_PROBE_TIMEOUT_MS=1500       # 远程沙箱探测超时；超时即降级 local
SANDBOX_TIMEOUT_MS=5000             # 单用例执行超时（毫秒），服务端 clamp 到 [1000,10000]
SANDBOX_MEMORY_MB=256               # 单用例内存上限（MB），服务端 clamp 到 [32,512]
SANDBOX_CPU_LIMIT_MS=4000           # CPU 时间上限（毫秒）
SANDBOX_MAX_OUTPUT_BYTES=65536      # 单用例输出上限（字节），超出截断并置 truncated=true
SANDBOX_ALLOW_NETWORK=false         # 是否允许联网（生产必须 false，服务端硬编码优先）
LOCAL_RUNNER_ENABLED=true           # 是否允许本地降级执行；生产设 false
SANDBOX_ALLOWED_IMPORTS=math,json,itertools,collections,re,string,sys,random,datetime,functools,heapq,bisect,typing  # 导入白名单（仅 SANDBOX_IMPORT_MODE=whitelist 时生效）
LOCAL_RUNNER_ROOT=./data/sandbox     # 本地 Runner 临时工作目录根（留空用系统临时目录）
SANDBOX_ANON_RUN=false               # /api/python/run 是否允许未登录（true 时开放匿名运行）
ALLOW_ANON_RUN=false                 # 同上，旧名兼容

# --------------------------------------------------- 沙箱服务自身（sandbox/）
SANDBOX_HOST=0.0.0.0                # 沙箱服务监听地址
SANDBOX_PORT=8081                   # 沙箱服务端口
SANDBOX_WORKDIR_ROOT=               # 沙箱临时工作目录根（留空用系统 temp/pythonlab-sandbox）
SANDBOX_STATIC_SCAN=true            # 是否开启执行前源码静态检查（第二层防线）
SANDBOX_IMPORT_MODE=blacklist       # blacklist|whitelist|off —— 默认黑名单（可用 numpy/pandas 等教学库）
SANDBOX_USE_UNSHARE=true            # Linux 下探测到 unshare 可用时启用网络命名空间隔离

# --------------------------------------------------------------------- AI
AI_PROVIDER=deepseek                # deepseek|openai|qwen|zhipu|anthropic|gemini|custom（均为 OpenAI 兼容）
AI_MODEL=deepseek-chat              # 模型名，如 deepseek-chat / gpt-4o-mini / qwen-plus / glm-4-flash
AI_BASE_URL=https://api.deepseek.com/v1   # OpenAI 兼容 Base URL（须以 /v1 结尾，见 docs/AI.md）
AI_API_KEY=                         # 留空即启用 RuleBasedProvider 离线规则降级（degraded=true）
AI_TEMPERATURE=0.3                  # 采样温度（教学场景偏低更稳）
AI_MAX_TOKENS=2048                  # 单次生成上限
AI_TIMEOUT_MS=30000                 # 模型调用超时；超时降级为规则助手
AI_OFFLINE=false                    # true = 强制离线规则助手（不发起任何外部请求）
AI_RATE_LIMIT_PER_HOUR=60           # 每用户每小时 AI 调用配额，超出返回 429 AI_RATE_LIMITED
AI_CACHE_TTL=600                    # AI 响应缓存秒数（相同提问命中缓存不消耗额度）
AI_DEFAULT_MODE=standard            # 默认教学语气：beginner|standard|advanced
AI_ALLOW_FULL_ANSWER_IN_DRILL=false # 练习模式是否允许直接给完整答案（默认禁止）

# 各厂商密钥（仅当 AI_PROVIDER 指向对应厂商时需要）
DEEPSEEK_API_KEY=                   # DeepSeek 平台密钥
OPENAI_API_KEY=                     # OpenAI 密钥
ANTHROPIC_API_KEY=                  # Anthropic（Claude），需走 OpenAI 兼容层，见 docs/AI.md
GEMINI_API_KEY=                     # Google Gemini（OpenAI 兼容端点）
QWEN_API_KEY=                       # 阿里通义千问（DashScope 兼容模式）
ZHIPU_API_KEY=                      # 智谱 GLM

# --------------------------------------------------------- 游戏化与激励
XP_PER_LESSON=10                    # 完成课时奖励 XP
XP_PER_AC=20                        # Accepted 一次奖励 XP
XP_PER_PROJECT=100                  # 完成项目奖励 XP
LEVEL_THRESHOLDS=0,100,300,700,1500,3000,6000  # 等级阈值（XP 累计）
DAILY_TASK_COUNT=3                  # 每日任务数量

# ------------------------------------------------------------------- 种子
SEED_ON_STARTUP=true                # 启动时自动导入种子（生产建议 false，改手动 seed）
SEEDS_DIR=../database/seeds         # 种子数据目录（相对 backend/ 解析）
ADMIN_EMAIL=admin@pythonlab.dev     # 初始管理员邮箱
ADMIN_PASSWORD=Admin@12345          # 初始管理员密码（生产必须修改）
ADMIN_USERNAME=admin                # 初始管理员用户名

# ------------------------------------------------------------------- 分页
DEFAULT_PAGE_SIZE=20                # 列表接口默认每页条数
MAX_PAGE_SIZE=100                   # 列表接口每页上限

# ------------------------------------------------------------------- 前端
NEXT_PUBLIC_API_BASE_URL=/api       # 前端请求前缀（经 Next rewrites 同源代理）
NEXT_PUBLIC_SITE_NAME=PYTHON LAB    # 站点名称（浏览器可见）
BACKEND_URL=http://127.0.0.1:8000   # 服务端 rewrites 目标（容器内用 http://backend:8000）
NEXT_TELEMETRY_DISABLED=1           # 关闭 Next.js 遥测

# ------------------------------------------------- Docker 编排专用（仅 compose 用）
POSTGRES_USER=pythonlab             # Postgres 用户名
POSTGRES_PASSWORD=pythonlab_pass    # Postgres 密码（生产用强随机）
POSTGRES_DB=pythonlab               # Postgres 库名
POSTGRES_PORT=5432                  # Postgres 宿主机端口
REDIS_PORT=6379                     # Redis 宿主机端口
FRONTEND_PORT=3000                  # 前端宿主机端口
NGINX_PORT=8080                     # Nginx HTTP 端口（profile=proxy 时生效）
NGINX_TLS_PORT=8443                 # Nginx HTTPS 端口
TZ=Asia/Shanghai                    # 容器时区
BACKEND_DOCKERFILE=Dockerfile       # backend 构建用的 Dockerfile（可用 ../docker/backend.Dockerfile）
FRONTEND_DOCKERFILE=Dockerfile      # frontend 构建用的 Dockerfile（可用 ../docker/frontend.Dockerfile）
